  "statements": [
    {"id": "cal-dir", "claim": "CONFIG_SOC_S5E9945 builds the cal_rt register layer.", "file": "drivers/gpu/drm/samsung/dpu/Makefile", "line": 8, "text": "cal-dir := cal_rt"},
    {"id": "win-block-shared", "claim": "DECON_WIN registers are accessed through descriptor 0 for every DECON id (one shared block at 0x19110000).", "file": "drivers/gpu/drm/samsung/dpu/cal_rt/decon_reg.c", "line": 78, "text": "cal_read(win_regs_desc(0), offset)"},
    {"id": "wincon-per-decon", "claim": "DECON_WINCON registers are per DECON id (DECON0_WINCON at 0x19130000).", "file": "drivers/gpu/drm/samsung/dpu/cal_rt/decon_reg.c", "line": 89, "text": "cal_read(wincon_regs_desc(id), offset)"},
    {"id": "chmap-written", "claim": "The channel number is written into WIN_CHMAP of DECON_CON_WIN(win).", "file": "drivers/gpu/drm/samsung/dpu/cal_rt/decon_reg.c", "line": 922, "text": "wincon_write_mask(id, DECON_CON_WIN(win_idx), val, mask);"},
    {"id": "channel-is-dpp-id", "claim": "The window channel is the DPP id (DT dpp,id).", "file": "drivers/gpu/drm/samsung/dpu/exynos_drm_decon.c", "line": 819, "text": "win_info.ch = dpp->id;"},
    {"id": "end-inclusive", "claim": "WIN_END_POSITION holds the inclusive last pixel (x2 - 1, y2 - 1).", "file": "drivers/gpu/drm/samsung/dpu/exynos_drm_decon.c", "line": 274, "text": "return (WIN_ENDPTR_Y_F(y2 - 1) | WIN_ENDPTR_X_F(x2 - 1));"},
    {"id": "dump-enabled-windows", "claim": "Samsung's own SFR dump treats WIN_EN_F in DECON_CON_WIN as 'window in use'.", "file": "drivers/gpu/drm/samsung/dpu/cal_rt/decon_reg.c", "line": 2784, "text": "if (!(WIN_EN_F(i) & wincon_read(id, DECON_CON_WIN(i))))"},
    {"id": "win-shadow", "claim": "DECON_WIN has a shadow copy at +SHADOW_OFFSET.", "file": "drivers/gpu/drm/samsung/dpu/cal_rt/decon_reg.c", "line": 2796, "text": "win_regs + WIN_OFFSET(i) + SHADOW_OFFSET, 0x20);"},
    {"id": "rsc-nibble", "claim": "RSC_STATUS holds the owning DECON id per channel/window in 4-bit fields.", "file": "drivers/gpu/drm/samsung/dpu/cal_rt/decon_reg.c", "line": 2889, "text": "return ((rsc_ch >> (ch * 4)) & 0xF);"},
    {"id": "rsc-ch-64bit", "claim": "Samsung reads RSC_STATUS_0/1 as one 64-bit access; the reader uses two 32-bit loads.", "file": "drivers/gpu/drm/samsung/dpu/cal_rt/decon_reg.c", "line": 2879, "text": "return decon_readq(id, RSC_STATUS_0);"},
    {"id": "dma-shadow", "claim": "DPU_DMA has a shadow copy at +DMA_SHD_OFFSET.", "file": "drivers/gpu/drm/samsung/dpu/cal_rt/dpp_reg.c", "line": 1796, "text": "=== DPU_DMA%d SHADOW SFR DUMP ==="},
    {"id": "src-width-is-frame", "claim": "RDMA_SRC_WIDTH receives the full frame width f_w.", "file": "drivers/gpu/drm/samsung/dpu/cal_rt/dpp_reg.c", "line": 270, "text": "dma_write(id, RDMA_SRC_WIDTH, IDMA_SRC_WIDTH(src->f_w));"},
    {"id": "f_w-is-fb-width", "claim": "f_w is the framebuffer width in pixels.", "file": "drivers/gpu/drm/samsung/dpu/exynos_drm_dpp.c", "line": 368, "text": "config->src.f_w = fb->width;"},
    {"id": "stride-sel", "claim": "A pitch register is written only with DMA_STRIDE_SEL and a non-zero stride; uncompressed RGB leaves stride[] zero.", "file": "drivers/gpu/drm/samsung/dpu/cal_rt/dpp_reg.c", "line": 1162, "text": "val = p->stride[i] ? DMA_STRIDE(p->stride[i]) | DMA_STRIDE_SEL : 0;"},
    {"id": "p0-is-plane0", "claim": "Uncompressed RGB: DMA_BASEADDR_P0 is the DMA address of plane 0.", "file": "drivers/gpu/drm/samsung/dpu/exynos_drm_dpp.c", "line": 264, "text": "config->addr[0] = exynos_drm_fb_dma_addr(fb, 0);"},
    {"id": "p0-write", "claim": "P0 is written verbatim.", "file": "drivers/gpu/drm/samsung/dpu/cal_rt/dpp_reg.c", "line": 1177, "text": "dma_write(id, DMA_BASEADDR_P0, p->addr[0]);"},
    {"id": "dma-addr-device", "claim": "The DMA address is the GEM device (IOMMU) address plus the plane offset.", "file": "drivers/gpu/drm/samsung/dpu/exynos_drm_fb.c", "line": 276, "text": "return exynos_gem->dma_addr + fb->offsets[index];"},
    {"id": "fmt-argb", "claim": "DRM_FORMAT_ARGB8888 maps to IDMA_IMG_FORMAT_ARGB8888.", "file": "drivers/gpu/drm/samsung/dpu/exynos_drm_format.c", "line": 48, "text": ".dma_fmt = IDMA_IMG_FORMAT_ARGB8888,"},
    {"id": "fmt-xrgb", "claim": "DRM_FORMAT_XRGB8888 maps to IDMA_IMG_FORMAT_XRGB8888.", "file": "drivers/gpu/drm/samsung/dpu/exynos_drm_format.c", "line": 96, "text": ".dma_fmt = IDMA_IMG_FORMAT_XRGB8888,"},
    {"id": "bootloader-dma-state", "claim": "Samsung notes that bootloader display state can leave DPU_DMA in an unclean state.", "file": "drivers/gpu/drm/samsung/dpu/cal_rt/dpp_reg.c", "line": 1428, "text": "When LCD is turned on in the bootloader, sometimes the hardware state of"},
    {"id": "handover-memory-region", "claim": "Linux's boot-framebuffer handover comes from a DSIM memory-region phandle, not a bootarg.", "file": "drivers/gpu/drm/samsung/dpu/exynos_drm_dsim.c", "line": 877, "text": "rmem_np = of_parse_phandle(np, \"memory-region\", 0);"},
    {"id": "handover-win-id", "claim": "The bootloader window id comes from DT lk-fb-win-id.", "file": "drivers/gpu/drm/samsung/dpu/exynos_drm_dsim.c", "line": 912, "text": "ret = of_property_read_u32(np, \"lk-fb-win-id\", &fb->lk_fb_win_id);"},
    {"id": "handover-keep-window", "claim": "With a reserved handover, Linux keeps the bootloader window enabled while disabling the others.", "file": "drivers/gpu/drm/samsung/dpu/exynos_drm_decon.c", "line": 1654, "text": "if (i == dsim->fb_handover.lk_fb_win_id)"},
    {"id": "handover-release", "claim": "The handover reservation is released at the first plane disable in video mode.", "file": "drivers/gpu/drm/samsung/dpu/exynos_drm_decon.c", "line": 871, "text": "dsim_free_fb_resource(dsim);"},
    {"id": "dotted-param-dropped", "claim": "An unconsumed dotted boot parameter (such as s3cfb.bootloaderfb) is dropped silently.", "file": "init/main.c", "line": 592, "text": "if (strnchr(param, len, '.'))"},
    {"id": "sysmmu-enable", "claim": "The SysMMU v9 driver enables translation by writing CTRL_MMU_ENABLE to REG_MMU_CTRL_VM for each VM in vmid_mask.", "file": "drivers/iommu/samsung/samsung-iommu-v9.c", "line": 247, "text": "__sysmmu_write_all_vm(data, ctrl_val, data->sfrbase + REG_MMU_CTRL_VM);"},
    {"id": "sysmmu-vm-mask", "claim": "Only VMs in vmid_mask are written.", "file": "drivers/iommu/samsung/samsung-iommu-v9.c", "line": 142, "text": "if (data->vmid_mask & (1 << i))"},
    {"id": "dt-decon0-op-mode", "claim": "Source DTS gives DECON0 MIPI command mode (runtime FDT agrees).", "file": "arch/arm64/boot/dts/exynos/s5e9945-drm-dpu.dtsi", "line": 871, "text": "op_mode = <1>;"},
    {"id": "dt-dpp0-dma", "claim": "Source DTS: DPP L0 DPU_DMA at 0x19900000 (runtime FDT agrees).", "file": "arch/arm64/boot/dts/exynos/s5e9945-drm-dpu.dtsi", "line": 40, "text": "reg = <0x0 0x19900000 0x1000>,"}
  ]
}
