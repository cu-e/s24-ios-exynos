<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="dev.egor.s24vmmviewer" android:versionCode="1" android:versionName="0.1.0">
    <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35" />
    <!-- Sockets to 127.0.0.1 only (the s24vmm display port); no other network use. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <application android:label="s24vmm viewer" android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen" android:allowBackup="false" android:debuggable="true">
        <activity android:name=".MainActivity" android:exported="true" android:screenOrientation="portrait" android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
