    {
      "id": "e1s-dependency-board",
      "scope": "build-correctness",
      "status": "unresolved",
      "finding": "setup.sh firehose and build/pthread/build.sh hardcode ARM64_BOARD_CONFIG_BCM2837; E1S source defines10 CPUs/four clusters versus BCM2837 eight/one. Trace affected layouts and build dependencies using the E1S profile; setting MACHINE=E1S alone does not change these defines."
    },
    {
      "id": "driverkit-iig",
      "scope": "runtime-compatibility",
      "status": "unqualified",
      "finding": "Donor copies pre-generated macOS13.3 DriverKit headers, emits partial/unsupported RPC implementations, and uses a no-op codesign wrapper. Presence/linking cannot qualify selected iOS services or hardware security."
    },
    {
      "id": "export-validation",
      "scope": "full-build-acceptance",
      "status": "unresolved",
      "finding": "Donor documents make exit2 after linking due to check_all_exports/symbolsets. Preserve actual failures and correct symbol/export contracts; a linked Mach-O is not a clean full build."
    },
