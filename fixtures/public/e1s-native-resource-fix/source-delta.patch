+def resource_inputs(root=RESOURCE_ROOT, headers=RESOURCE_HEADERS):
+    """Exact matched resource root: three regular files, nothing else, no aliases."""
+    root = Path(root)
+    require(root.is_dir() and not root.is_symlink() and root.resolve(strict=True) == root, 'Qualified resource root must be a canonical directory')
+    require(sorted(p.name for p in root.iterdir()) == sorted(headers), 'Resource root has missing or shadowing entries')
+    result = {}
+    for name, expected in headers.items():
+        path = root/name
+        require(path.is_file() and not path.is_symlink() and digest(path) == expected, 'Changed resource header: '+name)
+        result[str(path)] = expected
+    return result
+
+
+def rebind_resource(identifier, argv, absent=RESOURCE_ABSENT, root=RESOURCE_ROOT, selected=RESOURCE_OBJECT):
+    """Return argv with only the selected genuine APFS resource operand replaced."""
+    uses = [n for n, value in enumerate(argv) if value == '-idirafter']
+    mentions = [n for n, value in enumerate(argv) if absent in value]
+    if identifier != selected:
+        require(not uses and not mentions, 'Unexpected resource operand outside selected APFS object: '+identifier)
+        return list(argv)
+    require(len(uses) == 1 and uses[0]+1 < len(argv) and argv[uses[0]+1] == absent and mentions == [uses[0]+1], 'Selected APFS object lacks its exact genuine resource operand')
+    require(not Path(absent).exists() and not Path(absent).is_symlink(), 'Historical resource root unexpectedly exists')
+    result = list(argv)
+    result[uses[0]+1] = str(root)
+    return result
 
