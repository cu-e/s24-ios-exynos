--- a/e1s_display.c
+++ b/e1s_display.c
@@ -1,6 +1,8 @@
 #if defined(ARM64_BOARD_CONFIG_E1S)
 
 #include <console/video_console.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
 #include <libkern/libkern.h>
 #include <pexpert/pexpert.h>
 #include <sys/systm.h>
@@ -220,10 +222,118 @@
 	    e1s_display_read(ss, 0x08U));
 }
 
+/*
+ * NAT-176: a read-only snapshot of the display layers S-Boot left running, for display-hardware scaling of the iOS surface
+ * (NAT-162 table; Samsung e1s kernel 417484173abc). Loads only. The PMU status bit 0 of DPUB, DPUF0 and DPUF1 (stock pmucal
+ * "DPUB_STATUS" 0x12861D44, "DPUF0_STATUS" 0x12861D84, "DPUF1_STATUS" 0x128626C4) must all be set, or nothing else is read.
+ * Taken at probe and again at E1S_DPP_LATE_S seconds of uptime (iOS drawing, swipes running). boot-arg e1sdpp=0 turns it off.
+ */
+#define E1S_PMU_PA              0x12860000UL
+#define E1S_PMU_SIZE            0x3000U
+#define E1S_PMU_DPUB_STATUS     0x1d44U
+#define E1S_PMU_DPUF0_STATUS    0x1d84U
+#define E1S_PMU_DPUF1_STATUS    0x26c4U
+#define E1S_DPP_LATE_S          300U
+#define E1S_DPP_MAX_OFFS        20U
+
+struct e1s_dpp_group {
+	const char      *name;
+	uint64_t        pa;
+	uint32_t        size;
+	uint32_t        n;
+	uint16_t        off[E1S_DPP_MAX_OFFS];
+};
+
+#define E1S_WIN_OFFS    16, { 0x0, 0x4, 0x8, 0xc, 0x10, 0x14, 0x18, 0x1c, 0x800, 0x804, 0x808, 0x80c, 0x810, 0x814, 0x818, 0x81c }
+#define E1S_DMA_OFFS    19, { 0x8, 0xc, 0x10, 0x14, 0x18, 0x1c, 0x40, 0x50, 0x200, 0x338, 0x740, 0x408, 0x40c, 0x410, 0x414, \
+	                      0x418, 0x41c, 0x440, 0x450 }
+#define E1S_DPP_OFFS    13, { 0x0, 0x1c, 0x30, 0x34, 0x38, 0x3c, 0x80, 0x84, 0x88, 0x8c, 0x90, 0x94, 0x98 }
+
+static const struct e1s_dpp_group e1s_dpp_groups[] = {
+	{ "decon", 0x19100000UL, 0x1000U, 7, { 0x4, 0x30, 0x50, 0x60, 0x200, 0x204, 0x4 } },
+	{ "win2", 0x19112000UL, 0x1000U, E1S_WIN_OFFS },
+	{ "win3", 0x19113000UL, 0x1000U, E1S_WIN_OFFS },
+	{ "wincon2", 0x19132000UL, 0x1000U, 1, { 0x0 } },
+	{ "wincon3", 0x19133000UL, 0x1000U, 1, { 0x0 } },
+	{ "dma0", 0x19900000UL, 0x1000U, E1S_DMA_OFFS },
+	{ "dma1", 0x19901000UL, 0x1000U, E1S_DMA_OFFS },
+	{ "dpp0", 0x19930000UL, 0x1000U, E1S_DPP_OFFS },
+	{ "dpp1", 0x19931000UL, 0x1000U, E1S_DPP_OFFS },
+	{ "sramc0", 0x19950000UL, 0x1000U, 2, { 0x10, 0x14 } },
+	{ "sramc1", 0x19951000UL, 0x1000U, 2, { 0x10, 0x14 } },
+	{ "sysmmu", 0x19840000UL, 0x9000U, 5, { 0x0, 0x8, 0x34, 0x8000, 0x8404 } },
+};
+#define E1S_DPP_GROUPS  (sizeof(e1s_dpp_groups) / sizeof(e1s_dpp_groups[0]))
+
+static volatile uint32_t *e1s_dpp_pmu;
+static volatile uint32_t *e1s_dpp_map[E1S_DPP_GROUPS];
+
+static void
+e1s_dpp_snapshot(const char *when)
+{
+	uint32_t dpub, dpuf0, dpuf1;
+	unsigned g, i;
+
+	if (e1s_dpp_pmu == NULL) {
+		e1s_dpp_pmu = (volatile uint32_t *)ml_io_map(E1S_PMU_PA, E1S_PMU_SIZE);
+	}
+	if (e1s_dpp_pmu == NULL) {
+		printf("e1s-dpp: %s cannot map the PMU\n", when);
+		return;
+	}
+	dpub = e1s_display_read(e1s_dpp_pmu, E1S_PMU_DPUB_STATUS);
+	dpuf0 = e1s_display_read(e1s_dpp_pmu, E1S_PMU_DPUF0_STATUS);
+	dpuf1 = e1s_display_read(e1s_dpp_pmu, E1S_PMU_DPUF1_STATUS);
+	printf("e1s-dpp: %s pmu dpub %#x dpuf0 %#x dpuf1 %#x\n", when, dpub, dpuf0, dpuf1);
+	if ((dpub & dpuf0 & dpuf1 & 1U) == 0) {
+		printf("e1s-dpp: %s skipped: a display power domain is off\n", when);
+		return;
+	}
+	for (g = 0; g < E1S_DPP_GROUPS; g++) {
+		const struct e1s_dpp_group *grp = &e1s_dpp_groups[g];
+		char line[320];
+		int len;
+
+		if (e1s_dpp_map[g] == NULL) {
+			e1s_dpp_map[g] = (volatile uint32_t *)ml_io_map((vm_offset_t)grp->pa, grp->size);
+		}
+		if (e1s_dpp_map[g] == NULL) {
+			printf("e1s-dpp: %s %s cannot map %#llx\n", when, grp->name, (unsigned long long)grp->pa);
+			continue;
+		}
+		len = snprintf(line, sizeof(line), "e1s-dpp: %s %s %#llx", when, grp->name, (unsigned long long)grp->pa);
+		for (i = 0; i < grp->n && len > 0 && (size_t)len < sizeof(line); i++) {
+			len += snprintf(line + len, sizeof(line) - (size_t)len, " %x=%x", grp->off[i],
+			    e1s_display_read(e1s_dpp_map[g], grp->off[i]));
+		}
+		printf("%s\n", line);
+	}
+}
+
+static void
+e1s_dpp_late_thread(void *arg __unused, wait_result_t result __unused)
+{
+	uint64_t ns;
+
+	for (;;) {
+		absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+		if (ns >= (uint64_t)E1S_DPP_LATE_S * NSEC_PER_SEC) {
+			break;
+		}
+		delay_for_interval(1000, NSEC_PER_USEC * 1000);
+	}
+	e1s_dpp_snapshot("late");
+	for (;;) {
+		delay_for_interval(3600, NSEC_PER_SEC);
+	}
+}
+
 void
 e1s_display_probe(void)
 {
 	uint32_t mode = 1;
+	uint32_t dpp = 1;
+	thread_t thread;
 
 	(void)PE_parse_boot_argn("e1sdisp", &mode, sizeof(mode));
 	if (mode == 0) {
@@ -233,6 +343,15 @@
 	if (mode >= 2) {
 		e1s_display_pipeline();
 	}
+	(void)PE_parse_boot_argn("e1sdpp", &dpp, sizeof(dpp));
+	if (dpp == 0) {
+		return;
+	}
+	e1s_dpp_snapshot("probe");
+	if (kernel_thread_start(e1s_dpp_late_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+		printf("e1s-dpp: late snapshot thread started (at %u s)\n", E1S_DPP_LATE_S);
+	}
 }
 
 #endif /* ARM64_BOARD_CONFIG_E1S */
