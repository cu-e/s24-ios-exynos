 "absence_claims": [
  {
   "id": "AB1",
   "claim": "Within the Samsung/Exynos driver directories (drivers/power/reset/exynos, drivers/samsung, drivers/soc/samsung, drivers/watchdog, drivers/mfd) exactly one C file reads reboot-offset, so the vendor kernel has one software-reset trigger path for this SoC (drivers/power/reset/hisi-reboot.c, a HiSilicon driver, uses the same property name and is unrelated)",
   "pattern": "\"reboot-offset\"",
   "pathspec": [
    "drivers/power/reset/exynos/*.c",
    "drivers/samsung/*.c",
    "drivers/soc/samsung/*.c",
    "drivers/watchdog/*.c",
    "drivers/mfd/*.c"
   ],
   "expect_files": [
    "drivers/power/reset/exynos/exynos-reboot.c"
   ]
  },
  {
   "id": "AB2",
   "claim": "No driver matches the PMU compatible 'samsung,exynos991-pmu': the node is served by the generic syscon driver, so a PMU regmap write is one plain 32-bit MMIO store",
   "pattern": "exynos991-pmu",
   "pathspec": [
    ":(exclude)*.dts",
    ":(exclude)*.dtsi",
    ":(exclude)*.dtso"
   ],
   "expect_files": []
  },
  {
   "id": "AB3",
   "claim": "exynos-reboot.c does not know the command 'download' (it falls into the NORMAL-mode branch); sec_reboot.c does",
   "pattern": "\"download\"",
   "pathspec": [
    "drivers/power/reset/exynos/exynos-reboot.c",
    "drivers/samsung/sec_reboot.c"
   ],
   "expect_files": [
    "drivers/samsung/sec_reboot.c"
   ]
  }
 ],
