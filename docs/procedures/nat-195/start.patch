+#if defined(GENERIC_PSCI_SMP)
+/*
+ * NAT-152: marks 4-6 of a started core, out of line. Each is reached through a branch that takes
+ * the place of one that was there (same size), so that no instruction after this page moves: the
+ * boot loader checks start.s's checkpoint sites, loader_jump and _set_mmu_ttb at fixed addresses
+ * (NAT-151). Only a started core (x21 != 0) comes here.
+ */
+Lpsci_smp_mark4:
+	PSCI_SMP_EARLY_MARK 4, lr, x23				// stage 4: start_cpu, stacks set
+#if defined(NAT195_EL2_PROBE)
+	/*
+	 * NAT-195: a started core that is at EL2 (NAT-153) records the EL2 state the firmware left and
+	 * parks. Reads only: no EL2 register is written. Slots 3-6 of its marks are reused (stage 3 is
+	 * the hang path and stages 5-6 are never reached by a parked core); the last stage word is
+	 * 0x5EC000E2; then PSCI CPU_OFF, with a wfe park if it returns. A core at EL1 goes on as before.
+	 */
+	mrs		x9, CurrentEL
+	cmp		x9, #0x8
+	b.ne	common_start
+	mrs		x11, HCR_EL2
+	mrs		x12, SCTLR_EL2
+	PSCI_SMP_EARLY_MARK 3, x11, x12				// 3: HCR_EL2, SCTLR_EL2
+	mrs		x11, MDCR_EL2
+	mrs		x12, VBAR_EL2
+	PSCI_SMP_EARLY_MARK 4, x11, x12				// 4: MDCR_EL2, VBAR_EL2
+	mrs		x11, CNTHCTL_EL2
+	mrs		x12, CNTVOFF_EL2
+	PSCI_SMP_EARLY_MARK 5, x11, x12				// 5: CNTHCTL_EL2, CNTVOFF_EL2
+	mrs		x11, CPTR_EL2
+	mrs		x12, ICC_SRE_EL2
+	PSCI_SMP_EARLY_MARK 6, x11, x12				// 6: CPTR_EL2, ICC_SRE_EL2
+	mrs		x9, MPIDR_EL1
+	ubfx	x9, x9, #8, #4
+	adrp	x10, EXT(psci_smp_early_marks)@page
+	add		x10, x10, EXT(psci_smp_early_marks)@pageoff
+	add		x10, x10, x9, lsl #7
+	movz	x9, #0xE2
+	movk	x9, #0x5EC0, lsl #16
+	str		x9, [x10]
+	dc		cvac, x10
+	dsb		sy
+	movz	w0, #0x0002							// PSCI CPU_OFF (0x84000002, as psci_smp.c uses): back to the firmware, off,
+	movk	w0, #0x8400, lsl #16				// as the NAT-153 cores ended (AFFINITY_INFO 1)
+	smc		#0
+Lnat195_park:										// only if CPU_OFF returns
+
+	wfe
+	b		Lnat195_park
+#endif /* defined(NAT195_EL2_PROBE) */
+	b		common_start
+Lpsci_smp_mark5:
+	mrs		x11, TTBR1_EL1
+	mrs		x12, TCR_EL1
+	PSCI_SMP_EARLY_MARK 5, x11, x12				// stage 5: just before its MMU is on
+	b		Lpsci_smp_mark5_back
+Lpsci_smp_mark6:
+	mrs		x11, SCTLR_EL1
+	mov		x12, sp
+	PSCI_SMP_EARLY_MARK 6, x11, x12				// stage 6: its MMU on (V=P)
+	b		Lpsci_smp_mark6_back
+#endif /* defined(GENERIC_PSCI_SMP) */
+
 
