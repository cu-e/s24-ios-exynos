 /*
+ * boot-arg e1s_wdt_pet=1 (NAT-071): the e1s RECOVERY loader armed the S5E9945 CL0 watchdog (at most
+ * 83.9 s at 25.6 MHz) and fed it last just before the jump; nothing else feeds it while the kernel runs.
+ * Feed it from the 10 s heartbeat (hv_wdt_pet) -- the same two register writes as the loader's
+ * s5e_wdt_pet() --, only with a timed return (loader_return_after) and only until that time plus
+ * E1S_WDT_GRACE_S; then never again. A kernel that hangs makes no thread calls and stops feeding: the
+ * watchdog resets the phone at most 84 s later. The first feed must be seen to reload the counter;
+ * if anything is not as expected, nothing is fed and the timed return is cut back to
+ * E1S_WDT_UNFED_MAX_S, the window that is safe without a feed (the NAT-079 rule).
+ */
+#define E1S_WDT_PA              0x10040000ULL
+#define E1S_WDT_WTCON           (0x00 / 4)
+#define E1S_WDT_WTDAT           (0x04 / 4)
+#define E1S_WDT_WTCNT           (0x08 / 4)
+#define E1S_WDT_WTCLRINT        (0x0c / 4)
+#define E1S_WDT_ENABLED_RESET   0x21u
+#define E1S_WDT_GRACE_S         5
+#define E1S_WDT_UNFED_MAX_S     63
+
+static volatile uint32_t *e1s_wdt;
+static uint64_t e1s_wdt_until;          /* mach_absolute_time after which it is no longer fed */
+static uint32_t e1s_wdt_pets;
+static bool e1s_wdt_stopped;
+
+static void
+e1s_wdt_feed(void)
+{
+	if (e1s_wdt == NULL || e1s_wdt_stopped) {
+		return;
+	}
+	if (mach_absolute_time() >= e1s_wdt_until) {
+		e1s_wdt_stopped = true;
+		printf("e1s_wdt: no longer fed after %u feeds (loader_return_after + %u s passed)\n", e1s_wdt_pets, E1S_WDT_GRACE_S);
+		return;
+	}
+	e1s_wdt[E1S_WDT_WTCLRINT] = 0;
+	e1s_wdt[E1S_WDT_WTCNT] = e1s_wdt[E1S_WDT_WTDAT];
+	__builtin_arm_dsb(0xf);
+	e1s_wdt_pets++;
+}
+
+/* -> the timed return's length in seconds: `seconds` when the watchdog is being fed, else at most E1S_WDT_UNFED_MAX_S. */
+static uint32_t
+e1s_wdt_window(uint32_t seconds)
+{
+	uint32_t enabled = 0, con, dat, cnt0, cnt1;
+	uint64_t until;
+	volatile uint32_t *w;
+
+	if (!PE_parse_boot_argn("e1s_wdt_pet", &enabled, sizeof(enabled)) || enabled == 0) {
+		goto unfed;
+	}
+	w = (volatile uint32_t *)ml_io_map(E1S_WDT_PA, PAGE_SIZE);
+	if (w == NULL) {
+		printf("e1s_wdt: not fed: no mapping\n");
+		goto unfed;
+	}
+	con = w[E1S_WDT_WTCON];
+	dat = w[E1S_WDT_WTDAT];
+	if ((con & E1S_WDT_ENABLED_RESET) != E1S_WDT_ENABLED_RESET || dat < 64 || dat > 0xffff) {
+		printf("e1s_wdt: not fed: WTCON 0x%x WTDAT 0x%x\n", con, dat);
+		goto unfed;
+	}
+	cnt0 = w[E1S_WDT_WTCNT];
+	w[E1S_WDT_WTCLRINT] = 0;
+	w[E1S_WDT_WTCNT] = dat;
+	__builtin_arm_dsb(0xf);
+	cnt1 = w[E1S_WDT_WTCNT];
+	/* the counter runs at about 781 Hz: right after the reload it reads back within 1/64 of WTDAT */
+	if (cnt1 > dat || cnt1 < dat - (dat >> 6)) {
+		printf("e1s_wdt: not fed: WTCNT 0x%x -> 0x%x after reload to 0x%x\n", cnt0, cnt1, dat);
+		goto unfed;
+	}
+	clock_interval_to_deadline(seconds + E1S_WDT_GRACE_S, NSEC_PER_SEC, &until);
+	e1s_wdt_until = until;
+	e1s_wdt_pets = 1;
+	e1s_wdt = w;
+	printf("e1s_wdt: fed every 10 s for %u s (WTCON 0x%x WTDAT 0x%x WTCNT 0x%x -> 0x%x)\n", seconds + E1S_WDT_GRACE_S,
+	    con, dat, cnt0, cnt1);
+	return seconds;
+unfed:
+	if (seconds > E1S_WDT_UNFED_MAX_S) {
+		printf("e1s_wdt: loader_return_after %u cut to %u s: the watchdog is not fed\n", seconds, E1S_WDT_UNFED_MAX_S);
+		return E1S_WDT_UNFED_MAX_S;
+	}
+	return seconds;
+}
+/* end of e1s_wdt */
+
+/*
+ * boot-arg e1s_decon_hw=1 (NAT-119): DECON0 of the S5E9945 is in MIPI command mode (GLOBAL_CON 0x133, NAT-070): the panel takes
+ * a frame only when DECON is triggered. NAT-022 measured that after the loader's HW-form kick (mask the HW trigger, global
+ * shadow update request, unmask with HW_TRIG_EN) FRAME_COUNT runs at about 120 per second from the panel's TE, and after the
+ * SW-form kick it stops. The loader alternates both forms; nothing in this kernel triggers DECON. Here: the same HW-form kick
+ * once at the start of the timed window and again on every 10 s heartbeat, only while GLOBAL_CON reads enabled + command mode;
+ * the only registers written are TRIG_CON (0x30) and SHD_REG_UP_REQ (0x50). Each kick prints TRIG_CON before/after and
+ * FRAME_COUNT, so the frame-counter delta between two kicks is the measured panel refresh while iOS runs.
+ */
+#define E1S_DECON0_PA           0x19100000ULL
+#define E1S_DECON_FRAME_COUNT   (0x04 / 4)
+#define E1S_DECON_GLOBAL_CON    (0x20 / 4)
+#define E1S_DECON_TRIG_CON      (0x30 / 4)
+#define E1S_DECON_SHD_REG_UP    (0x50 / 4)
+#define E1S_GC_EN               0x3u
+#define E1S_GC_CMD              (1u << 8)
+#define E1S_TC_HW_TRIG_EN       (1u << 0)
+#define E1S_TC_HW_TRIG_MASK     (1u << 4)
+#define E1S_SHD_GLOBAL          (1u << 31)
+#define E1S_DECON_MAX_KICKS     64
+
+static volatile uint32_t *e1s_decon;
+static uint32_t e1s_decon_kicks, e1s_decon_last_fc;
+static bool e1s_decon_off;
+
+static void
+e1s_decon_kick(void)
+{
+	uint32_t gc, tc0, tc1, fc;
+	uint32_t enabled = 0;
+
+	if (e1s_decon_off || e1s_decon_kicks >= E1S_DECON_MAX_KICKS) {
+		return;
+	}
+	if (e1s_decon == NULL) {
+		if (!PE_parse_boot_argn("e1s_decon_hw", &enabled, sizeof(enabled)) || enabled == 0) {
+			e1s_decon_off = true;
+			return;
+		}
+		e1s_decon = (volatile uint32_t *)ml_io_map(E1S_DECON0_PA, PAGE_SIZE);
+		if (e1s_decon == NULL) {
+			printf("e1s_decon: no mapping\n");
+			e1s_decon_off = true;
+			return;
+		}
+	}
+	gc = e1s_decon[E1S_DECON_GLOBAL_CON];
+	tc0 = e1s_decon[E1S_DECON_TRIG_CON];
+	fc = e1s_decon[E1S_DECON_FRAME_COUNT];
+	if ((gc & E1S_GC_EN) != E1S_GC_EN || (gc & E1S_GC_CMD) == 0) {
+		printf("e1s_decon: not kicked: GLOBAL_CON 0x%x TRIG_CON 0x%x FRAME_COUNT %u\n", gc, tc0, fc);
+		e1s_decon_off = true;
+		return;
+	}
+	e1s_decon[E1S_DECON_TRIG_CON] = tc0 | E1S_TC_HW_TRIG_EN | E1S_TC_HW_TRIG_MASK;          /* mask */
+	__builtin_arm_dsb(0xf);
+	e1s_decon[E1S_DECON_SHD_REG_UP] = e1s_decon[E1S_DECON_SHD_REG_UP] | E1S_SHD_GLOBAL;
+	__builtin_arm_dsb(0xf);
+	e1s_decon[E1S_DECON_TRIG_CON] = (e1s_decon[E1S_DECON_TRIG_CON] & ~(E1S_TC_HW_TRIG_EN | E1S_TC_HW_TRIG_MASK)) | E1S_TC_HW_TRIG_EN;  /* unmask */
+	__builtin_arm_dsb(0xf);
+	tc1 = e1s_decon[E1S_DECON_TRIG_CON];
+	e1s_decon_kicks++;
+	printf("e1s_decon: kick %u GLOBAL_CON 0x%x TRIG_CON 0x%x -> 0x%x FRAME_COUNT %u (+%u)\n", e1s_decon_kicks, gc, tc0, tc1, fc,
+	    e1s_decon_kicks > 1 ? fc - e1s_decon_last_fc : 0);
+	e1s_decon_last_fc = fc;
+}
+/* end of e1s_decon */
