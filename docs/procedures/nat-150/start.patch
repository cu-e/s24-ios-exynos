@@ -88,6 +88,35 @@
 #endif /* defined(KERNEL_INTEGRITY_KTRR) */
 .endmacro
 
+#if defined(GENERIC_PSCI_SMP)
+/*
+ * NAT-150: how far a core that PSCI CPU_ON started has got, for the boot processor to read
+ * (psci_smp_start_cpu()). Each core has 128 bytes of psci_smp_early_marks (psci_smp.c), found
+ * by its MPIDR Affinity1: [0] 0x5EC00000 | the last stage reached, [8] its MPIDR,
+ * [16 * stage] and [16 * stage + 8] the two registers given. Addressed as the core runs: by
+ * physical address with the MMU off (the store goes to memory), through the V=P mapping just
+ * after it is on; then cleaned to the point of coherency. Uses x9 and x10 only; flags unchanged.
+ */
+.macro PSCI_SMP_EARLY_MARK stage, ra, rb
+	mrs		x9, MPIDR_EL1
+	ubfx	x9, x9, #8, #4
+	adrp	x10, EXT(psci_smp_early_marks)@page
+	add		x10, x10, EXT(psci_smp_early_marks)@pageoff
+	add		x10, x10, x9, lsl #7
+	str		\ra, [x10, #(16 * \stage)]
+	str		\rb, [x10, #(16 * \stage + 8)]
+	mrs		x9, MPIDR_EL1
+	str		x9, [x10, #8]
+	movz	x9, #\stage
+	movk	x9, #0x5EC0, lsl #16
+	str		x9, [x10]
+	dc		cvac, x10
+	add		x10, x10, #64
+	dc		cvac, x10
+	dsb		sy
+.endm
+#endif /* defined(GENERIC_PSCI_SMP) */
+
