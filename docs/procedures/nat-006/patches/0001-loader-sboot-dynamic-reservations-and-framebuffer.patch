+
+/* Framebuffer source: 1 = simple-framebuffer node, 2 = e1s S-Boot bootargs
+ * fallback (pixel format and stride assumed), 0 = none. */
+static int
+loader_select_fb(uintptr_t dtb, uint64_t *base, uint64_t *size, uint32_t *w,
+    uint32_t *h, uint32_t *stride)
+{
+	if (fdt_find_framebuffer(dtb, base, size, w, h, stride)) return 1;
+	if (fdt_sboot_framebuffer(dtb, base, size, w, h, stride)) return 2;
+	*base = *size = 0; *w = *h = *stride = 0;
+	return 0;
+}
