+/* NAT-172: this phone's cluster-0 levels (Android policy0 scaling_available_frequencies, docs/procedures/nat-171). */
+static const uint32_t e1s_cl0_khz[] = {
+	400000, 576000, 672000, 768000, 864000, 960000, 1056000, 1152000, 1248000, 1344000, 1440000, 1536000, 1632000, 1728000,
+	1824000, 1920000, 1959000,
+};
+
+/* Dependent adds per microsecond, best of three runs of 8 Mi adds: about the core clock in MHz on an in-order core. */
+static uint32_t
+e1s_add_rate(void)
+{
+	uint32_t best = 0;
+
+	for (int run = 0; run < 3; run++) {
+		uint64_t x = 0, began = mach_absolute_time(), ns;
+		uint32_t rate;
+
+		for (uint32_t i = 0; i < 262144U; i++) {
+#if defined(__arm64__) || defined(__aarch64__)
+			__asm__ volatile (".rept 32\n\tadd %0, %0, #1\n\t.endr" : "+r" (x));
+#else
+			__asm__ volatile ("" : "+r" (x));
+			x += 32;
+#endif
+		}
+		absolutetime_to_nanoseconds(mach_absolute_time() - began, &ns);
+		rate = ns != 0 ? (uint32_t)(262144ULL * 32U * 1000U / ns) : 0;
+		if (rate > best) {
+			best = rate;
+		}
+	}
+	return best;
+}
+
+/* PLL_CPUCL0 output in kHz from PLL_CON3 (integer part only), or 0 if the fields cannot be a running PLL. */
+static uint32_t
+e1s_pll_khz(volatile uint32_t *cmu, uint32_t *raw)
+{
+	uint32_t v = cmu[E1S_PLL_CPUCL0_CON3 / 4], m = (v >> 16) & 0x3ffU, p = (v >> 8) & 0x3fU, s = v & 7U;
+
+	*raw = v;
+	if (!(v & (1U << 31)) || m == 0 || p == 0) {
+		return 0;
+	}
+	return (uint32_t)((uint64_t)E1S_OSCCLK_KHZ * m / ((uint64_t)p << s));
+}
+
+static void
+e1s_cpuclk_raise(void)
+{
+	uint32_t target = 1959000, raw, before, after, rate;
+	uint32_t cmd[E1S_ACPM_CMD_WORDS];
+	volatile uint32_t *cmu;
+	bool stock = false;
+	int error;
+
+	PE_parse_boot_argn("e1scpuclk", &target, sizeof(target));
+	if (target == 0) {
+		printf("e1s-cpuclk: off (e1scpuclk=0)\n");
+		return;
+	}
+	for (unsigned i = 0; i < sizeof(e1s_cl0_khz) / sizeof(e1s_cl0_khz[0]); i++) {
+		stock |= e1s_cl0_khz[i] == target;
+	}
+	cmu = (volatile uint32_t *)ml_io_map(E1S_CMU_CPUCL0_PA, 0x1000);
+	if (cmu == NULL) {
+		printf("e1s-cpuclk: cannot map CMU_CPUCL0\n");
+		return;
+	}
+	before = e1s_pll_khz(cmu, &raw);
+	rate = e1s_add_rate();
+	printf("e1s-cpuclk: before: pll con3 0x%08x = %u kHz; %u adds/us; mbox INTMR1 0x%08x\n", raw, before, rate,
+	    e1s_acpm_mbox_read(E1S_ACPM_INTMR1));
+	if (!stock) {
+		printf("e1s-cpuclk: %u kHz is not a stock cluster-0 level; no request\n", target);
+		return;
+	}
+	if (!e1s_acpm_dvfs.valid) {
+		printf("e1s-cpuclk: no DVFS channel; no request\n");
+		return;
+	}
+	/* CON3 gives the integer part only (1959000 decodes as 1958400 with M 102 P 1 S 2), so within 1% counts as there. */
+	if (before == 0 || before >= target - target / 100) {
+		printf("e1s-cpuclk: PLL %s; no request\n", before == 0 ? "not decoded" : "already at the target");
+		return;
+	}
+	cmd[0] = E1S_DVFS_CPUCL0;
+	cmd[1] = target;
+	cmd[2] = E1S_DVFS_FREQ_REQ;
+	cmd[3] = 0;
+	error = e1s_acpm_send_ch(&e1s_acpm_dvfs, cmd);
+	printf("e1s-cpuclk: FREQ_REQ cluster 0 %u kHz on channel 0: error %d, reply %08x %08x %08x %08x\n", target, error,
+	    cmd[0], cmd[1], cmd[2], cmd[3]);
+	delay(50000);
+	after = e1s_pll_khz(cmu, &raw);
+	rate = e1s_add_rate();
+	printf("e1s-cpuclk: after: pll con3 0x%08x = %u kHz; %u adds/us\n", raw, after, rate);
+}
