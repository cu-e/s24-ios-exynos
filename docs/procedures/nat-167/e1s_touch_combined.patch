+/*
+ * NAT-141: Samsung's screen-on start of the STM (pinned stm_core.c stm_ts_start_device -> stm_ts_reinit, stm_fn.c 308-640):
+ * system reset (FA 20 00 00 24 81, 10 ms, wait for the READY status event), CLEAR_ALL_EVENT (C0 62), scan mode A0 00 01 with
+ * its echo event, SENSE_ON (C0 10). No force calibration, no panel calibration, no firmware update, nothing written to flash.
+ * Then a polled event thread: 0x87 reads every e1s_poll_us, coordinate events posted to /dev/hakios-touch. No IRQ is attached.
+ */
+#define STM_STATUS_REPORT       0x43
+#define STM_ERROR_REPORT        0xF3
+#define STM_WAIT_TRIES          150     /* stm_fn.c: STM_TS_RETRY_COUNT * 15, 20 ms apart */
+#define E1S_EV_LOG_COORD        64
+#define E1S_EV_LOG_OTHER        16
+#define E1S_EV_LOG_TOUCH        512     /* NAT-143: every press and release, with the kernel time, for the UI correlation */
+
+static void
+ev_print(const char *what, const uint8_t *ev)
+{
+	printf("e1s-touch: %s %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x\n", what,
+	    ev[0], ev[1], ev[2], ev[3], ev[4], ev[5], ev[6], ev[7], ev[8], ev[9], ev[10], ev[11], ev[12], ev[13], ev[14], ev[15]);
+}
+
+static int
+stm_wait_ready(void)
+{
+	for (unsigned i = 0; i < STM_WAIT_TRIES; i++) {
+		uint8_t ev[STM_EVENT_SIZE] = { 0 };
+
+		stm_read_command(STM_READ_ONE_EVENT, ev, sizeof(ev));
+		if (((ev[0] >> 2) & 0xf) == 2 && ev[1] == 0x00) {
+			printf("e1s-touch: start: ready after %u read(s)\n", i + 1);
+			ev_print("start: ready event", ev);
+			return 0;
+		}
+		if (ev[0] == 0xff && ev[1] == 0xff && ev[2] == 0xff) {
+			printf("e1s-touch: start: ready wait read ff ff ff (broken firmware per stm_fn.c)\n");
+			return -1;
+		}
+		if (ev[0] == STM_ERROR_REPORT) {
+			ev_print("start: error event", ev);
+		}
+		delay_for_interval(20000, NSEC_PER_USEC);
+	}
+	printf("e1s-touch: start: no ready event in %u reads\n", STM_WAIT_TRIES);
+	return -1;
+}
+
+static int
+stm_echo(const uint8_t *cmd, uint32_t n)
+{
+	uint32_t cmp = n > 4 ? 4 : n;
+
+	stm_write(cmd, n, NULL, 0);
+	delay_for_interval(20000, NSEC_PER_USEC);
+	for (unsigned i = 0; i < STM_WAIT_TRIES; i++) {
+		uint8_t ev[STM_EVENT_SIZE] = { 0 };
+		bool matched = true;
+
+		stm_read_command(STM_READ_ONE_EVENT, ev, sizeof(ev));
+		if (ev[0] == STM_STATUS_REPORT && ev[1] == 0x01) {
+			for (uint32_t k = 0; k < cmp; k++) {
+				if (ev[k + 2] != cmd[k]) {
+					matched = false;
+				}
+			}
+			if (matched) {
+				printf("e1s-touch: start: echo of %02x after %u read(s)\n", cmd[0], i + 1);
+				return 0;
+			}
+		}
+		if (ev[0] == STM_ERROR_REPORT) {
+			ev_print("start: error event", ev);
+		}
+		delay_for_interval(20000, NSEC_PER_USEC);
+	}
+	printf("e1s-touch: start: no echo of %02x in %u reads\n", cmd[0], STM_WAIT_TRIES);
+	return -1;
+}
+
+static void
+e1s_touch_ev_thread(void *arg __unused, wait_result_t result __unused)
+{
+	static const uint8_t reset_reg = 0xFA;
+	static const uint8_t reset_data[5] = { 0x20, 0x00, 0x00, 0x24, 0x81 };
+	static const uint8_t clear_all = 0x62;
+	static const uint8_t scan_on[3] = { 0xA0, 0x00, 0x01 };
+	static const uint8_t sense_on = 0x10;
+	uint32_t polls = 0, irq_low = 0, coords = 0, n_press = 0, n_release = 0, other = 0, logged_c = 0, logged_o = 0, logged_t = 0, reports = 0;
+	uint32_t report_every = e1s_poll_us < 10000000U ? 10000000U / e1s_poll_us : 1U;
+	int ready, echo;
+
+	printf("e1s-touch: start: system reset\n");
+	stm_write(&reset_reg, 1, reset_data, sizeof(reset_data));
+	delay_for_interval(10000, NSEC_PER_USEC);
+	ready = stm_wait_ready();
+	stm_write(&clear_all, 1, NULL, 0);
+	echo = stm_echo(scan_on, sizeof(scan_on));
+	stm_write(&sense_on, 1, NULL, 0);
+	printf("e1s-touch: start: sense on (ready %s, scan echo %s); polling events every %u us, no IRQ\n",
+	    ready == 0 ? "yes" : "no", echo == 0 ? "yes" : "no", e1s_poll_us);
+
+	for (;;) {
+		polls++;
+		if (!pin_get(E1S_GPA1_DAT, E1S_TOUCH_IRQ_PIN)) {
+			irq_low++;
+		}
+		for (uint32_t i = 0; i < STM_MAX_EVENTS; i++) {
+			uint8_t ev[STM_EVENT_SIZE] = { 0 };
+
+			stm_read_command(STM_READ_ONE_EVENT, ev, sizeof(ev));
+			if (ev[0] == 0) {
+				break;
+			}
+			if ((ev[0] & 0x3) == STM_EVENT_COORD) {
+				uint32_t action = ev[0] >> 6;
+
+				coords++;
+				n_press += action == STM_COORD_PRESS;
+				n_release += action == STM_COORD_RELEASE;
+				if (logged_c < E1S_EV_LOG_COORD) {
+					logged_c++;
+					printf("e1s-touch: coord %u: finger %u action %u x %u y %u\n", coords, (ev[0] >> 2) & 0xf, action,
+					    ((uint32_t)ev[1] << 4) | (ev[3] >> 4), ((uint32_t)ev[2] << 4) | (ev[3] & 0x0f));
+				}
+				if ((action == STM_COORD_PRESS || action == STM_COORD_RELEASE) && logged_t < E1S_EV_LOG_TOUCH) {
+					logged_t++;
+					printf("e1s-touch: %s %u: finger %u x %u y %u\n", action == STM_COORD_PRESS ? "press" : "release",
+					    action == STM_COORD_PRESS ? n_press : n_release, (ev[0] >> 2) & 0xf,
+					    ((uint32_t)ev[1] << 4) | (ev[3] >> 4), ((uint32_t)ev[2] << 4) | (ev[3] & 0x0f));
+				}
+				post_event(ev);
+			} else {
+				other++;
+				if (logged_o < E1S_EV_LOG_OTHER) {
+					logged_o++;
+					ev_print("event", ev);
+				}
+			}
+		}
+		if (polls % report_every == 0 && reports < 30) {
+			reports++;
+			printf("e1s-touch: events after %u polls: coord %u (press %u release %u) other %u; irq line low in %u polls\n",
+			    polls, coords, n_press, n_release, other, irq_low);
+		}
+		delay_for_interval(e1s_poll_us, NSEC_PER_USEC);
+	}
+}
