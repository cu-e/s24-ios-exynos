+		FlushPoC_DcacheRegion((vm_offset_t)mark, sizeof(psci_smp_early_marks[0]));
 		if (psci_smp_start_fault.valid != 0) {
 			break;
 		}
@@ -223,6 +243,11 @@
 		    cpu, phys_id, PSCI_SMP_START_SECONDS,
 		    stage >= PSCI_SMP_CPU_IN_KERNEL ? "it got as far as arm_init_cpu()" : "no sign of it since the firmware took the request");
 	}
+	FlushPoC_DcacheRegion((vm_offset_t)mark, sizeof(psci_smp_early_marks[0]));
+	printf("psci: cpu %d early marks: last 0x%llx mpidr 0x%llx 1:0x%llx,0x%llx 2:0x%llx,0x%llx 3:0x%llx,0x%llx "
+	    "4:0x%llx,0x%llx 5:0x%llx,0x%llx 6:0x%llx,0x%llx affinity_info %lld\n",
