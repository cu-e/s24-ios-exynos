+bool PointerExprEvaluator::VisitUnaryExprOrTypeTraitExpr(
+    const UnaryExprOrTypeTraitExpr *E) {
+  if (E->getKind() != UETT_XnuTypeSignature || !E->isArgumentType())
+    return Error(E);
+  std::string Signature;
+  uint32_t Summary;
+  if (!XnuTypeMetadata(Info.Ctx).compute(E->getArgumentType(), Signature, Summary))
+    return Error(E);
+  QualType ArrayTy = Info.Ctx.getConstantArrayType(
+      Info.Ctx.CharTy, llvm::APInt(64, Signature.size() + 1), nullptr,
+      ArrayType::Normal, 0);
+  auto *SL = StringLiteral::Create(Info.Ctx, Signature, StringLiteral::Ordinary,
+                                 false, ArrayTy, E->getExprLoc());
+  if (!evaluateLValue(SL, Result))
+    return false;
+  Result.addArray(Info, E, cast<ConstantArrayType>(ArrayTy));
+  return true;
 }
 
