+/* Validate only the supplied FDT's declared bounds; physical accessibility is
+ * still an S-Boot handoff requirement. No physical RAM is certified here. */
+#define FDT_MAX_SIZE (2U << 20)
+struct fdt_bounds {
+	uintptr_t structure, end, strings, strings_end, reserve, reserve_end;
+};
+
+static int
+fdt_bounds(uintptr_t fdt, struct fdt_bounds *b)
+{
+	uint32_t total, so, ss, to, ts, ro;
+	if (!fdt || fdt > UINTPTR_MAX - 40 || (fdt & 7) || be32(fdt) != FDT_MAGIC)
+		return 0;
+	total = be32(fdt + 4);
+	if (total < 40 || total > FDT_MAX_SIZE || fdt > UINTPTR_MAX - total ||
+	    be32(fdt + 20) != 17 || be32(fdt + 24) > 17)
+		return 0;
+	so = be32(fdt + 8); to = be32(fdt + 12); ro = be32(fdt + 16);
+	ts = be32(fdt + 32); ss = be32(fdt + 36);
+	if (so < 40 || to < 40 || ro < 40 || (so & 3) || (ro & 7) ||
+	    so > total || ss > total - so || ss < 12 || (ss & 3) ||
+	    to > total || ts > total - to || ro > total || total - ro < 16 ||
+	    (so < to + ts && to < so + ss) ||
+	    (ro >= so && ro < so + ss) || (ro >= to && ro < to + ts))
+		return 0;
+	b->structure = fdt + so; b->end = b->structure + ss;
+	b->strings = fdt + to; b->strings_end = b->strings + ts;
+	b->reserve = fdt + ro; b->reserve_end = fdt + total;
+	if (so > ro && fdt + so < b->reserve_end) b->reserve_end = fdt + so;
+	if (to > ro && fdt + to < b->reserve_end) b->reserve_end = fdt + to;
+	return 1;
+}
+
+static uintptr_t
+bounded_string_end(uintptr_t p, uintptr_t end)
+{
+	while (p < end) {
+		if (*(const volatile char *)p++ == 0) return p;
+	}
+	return 0;
+}
+
+static int
+reserve_map(const struct fdt_bounds *b, struct fdt_range *out, int max,
+    int *count)
+{
+	for (uintptr_t p = b->reserve; p <= b->reserve_end - 16; p += 16) {
+		uint64_t base = (uint64_t)be32(p) << 32 | be32(p + 4);
+		uint64_t size = (uint64_t)be32(p + 8) << 32 | be32(p + 12);
+		if (!base && !size) return 1;
+		if (!size || size > UINT64_MAX - base) return 0;
+		if (out) {
+			if (*count >= max) return 0;
+			out[*count].base = base; out[*count].size = size; (*count)++;
+		}
+	}
+	return 0;
+}
+
+int
+fdt_validate(uintptr_t fdt)
+{
+	struct fdt_bounds b;
+	uintptr_t p;
+	int depth = 0, root = 0, closed = 0, count = 0;
+	if (!fdt_bounds(fdt, &b) || !reserve_map(&b, 0, 0, &count)) return 0;
+	p = b.structure;
+	while (p <= b.end - 4) {
+		uint32_t tok = be32(p); p += 4;
+		if (tok == FDT_BEGIN_NODE) {
+			if (p >= b.end || closed || ++depth > 12 || (!root && *(const char *)p)) return 0;
+			root = 1; p = bounded_string_end(p, b.end);
+			if (!p || p > UINTPTR_MAX - 3) return 0;
+			p = align4(p);
+		} else if (tok == FDT_PROP) {
+			if (!depth || b.end - p < 8) return 0;
+			uint32_t len = be32(p), off = be32(p + 4); p += 8;
+			if (len > b.end - p || p + len > UINTPTR_MAX - 3 ||
+			    off >= b.strings_end - b.strings ||
+			    !bounded_string_end(b.strings + off, b.strings_end)) return 0;
+			/* fb_walk also reads compatible as a string list. */
+			if (streq((const char *)(b.strings + off), "compatible") &&
+			    (!len || *(const char *)(p + len - 1))) return 0;
+			p = align4(p + len);
+		} else if (tok == FDT_END_NODE) {
+			if (!depth) return 0;
+			if (--depth == 0) closed = 1;
+		} else if (tok == FDT_END) {
+			if (!root || !closed || depth) return 0;
+			while (p < b.end) if (*(const char *)p++) return 0;
+			return 1;
+		} else if (tok != FDT_NOP) return 0;
+		if (p > b.end) return 0;
+	}
+	return 0;
+}
+
+static int
+range_reg(uintptr_t val, uint32_t len, uint32_t ac, uint32_t sc,
+    struct fdt_range *out, int max, int *count)
+{
+	if (!ac || !sc || ac > 2 || sc > 2 || !len || len % (4 * (ac + sc)))
+		return 0;
+	uint32_t stride = 4 * (ac + sc);
+	for (uint32_t off = 0; off < len; off += stride) {
+		uint64_t base = 0, size = 0;
+		for (uint32_t i = 0; i < ac; i++) base = base << 32 | be32(val + off + 4*i);
+		for (uint32_t i = 0; i < sc; i++) size = size << 32 | be32(val + off + 4*(ac+i));
+		if (size > UINT64_MAX - base) return 0;
+		if (!size) continue;
+		if (*count >= max) return 0;
+		out[*count].base = base; out[*count].size = size; (*count)++;
+	}
+	return 1;
+}
