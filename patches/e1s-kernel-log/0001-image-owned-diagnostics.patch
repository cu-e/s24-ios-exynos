--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -637,15 +637,24 @@
 .endmacro
 
 /*
- * E1S bring-up: leave the checkpoint in the reserved sec_debug_next page
- * before the MMU is enabled. The loader writes the magic at 0x912ff000.
- */
+ * E1S checkpoints belong to the kernel image, not an assumed reserved PA.
+ * Keep the slot file-backed: these stores precede C/BSS initialization.
+ * All callers execute with the MMU off (or V=P), so ADRP/ADD yields its PA.
+ * Only x9/x10 are scratch, as in the original marker.
+ */
+#if defined(E1S)
+	.section __DATA,__data
+	.align 3
+Le1s_boot_marker:
+	.quad 0x4531534d41524b00
+	.text
+#endif
 .macro E1S_BOOT_MARK n
 #if defined(E1S)
-	movz	x9, #0xf000
-	movk	x9, #0x912f, lsl #16
+	adrp	x9, Le1s_boot_marker@page
+	add	x9, x9, Le1s_boot_marker@pageoff
 	movz	x10, #\n
-	str	x10, [x9, #8]
+	str	x10, [x9]
 #endif
 .endm
 
--- a/bsd/dev/e1s_log.c
