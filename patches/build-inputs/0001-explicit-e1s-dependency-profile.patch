diff --git a/xnu-deps/host/bin/xnu-clang b/xnu-deps/host/bin/xnu-clang
--- a/xnu-deps/host/bin/xnu-clang
+++ b/xnu-deps/host/bin/xnu-clang
@@ -16,3 +16,10 @@
 done
-exec /usr/bin/$drv -include "$HB/../../hostinc/xnu_clang_compat.h" -target arm64-apple-ios${XNU_SDK_VERSION:-16.5} --ld-path="$HB/ld64" \
+if [ "$drv" = clang++ ]; then
+  compiler=${S24_XNU_CLANGXX:?Set S24_XNU_CLANGXX to the explicit installed clang++ executable}
+else
+  compiler=${S24_XNU_CLANG:?Set S24_XNU_CLANG to the explicit installed clang executable}
+fi
+case "$compiler" in /*) ;; *) echo "XNU compiler path must be absolute" >&2; exit 1;; esac
+[ -x "$compiler" ] || { echo "XNU compiler is not executable" >&2; exit 1; }
+exec "$compiler" -include "$HB/../../hostinc/xnu_clang_compat.h" -target arm64-apple-ios${XNU_SDK_VERSION:-16.5} --ld-path="$HB/ld64" \
   -w "${extra[@]}" "${args[@]}"
