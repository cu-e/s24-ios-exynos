+
+/* Preserve the existing payload reserve, expanding it only to include the
+ * actual linker-defined loader end. Numeric exclusion is not physical ownership. */
+static int
+loader_reserved_size(uintptr_t image, uintptr_t end, uintptr_t payload,
+    uint64_t *out)
+{
+	const uint64_t reserve = 32UL << 20;
+	uint64_t size = 0x40000 + reserve;
+	if (end < image)
+		return 0;
+	if (payload > image) {
+		uint64_t offset = payload - image;
+		if (offset > UINT64_MAX - reserve)
+			return 0;
+		size = offset + reserve;
+	}
+	if ((uint64_t)(end - image) > size)
+		size = end - image;
+	if (size > UINT64_MAX - image)
+		return 0;
+	*out = size;
+	return 1;
 }
 
