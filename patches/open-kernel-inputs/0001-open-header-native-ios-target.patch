+            #define TARGET_OS_EMBEDDED      1
+        #endif
+        #define TARGET_OS_RTKIT             0
+        #define TARGET_OS_MACCATALYST       0
+        #ifndef TARGET_OS_UIKITFORMAC
+            #define TARGET_OS_UIKITFORMAC   0
