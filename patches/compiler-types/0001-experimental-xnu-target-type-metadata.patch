+static void handleXnuUsageSemanticsAttr(Sema &S, Decl *D, const ParsedAttr &AL) {
+  if (!AL.checkAtLeastNumArgs(S, 1)) return;
+  llvm::SmallVector<StringRef, 2> Values;
+  for (unsigned I = 0; I != AL.getNumArgs(); ++I) {
+    StringRef Value;
+    if (!S.checkStringLiteralArgumentAttr(AL, I, Value)) return;
+    if (Value != "pointer" && Value != "data") {
+      S.Diag(AL.getLoc(), S.getDiagnostics().getCustomDiagID(
+          DiagnosticsEngine::Error, "unsupported XNU usage semantic"));
+      return;
+    }
+    Values.push_back(Value);
+  }
+  D->addAttr(::new (S.Context) XnuUsageSemanticsAttr(
+      S.Context, AL, Values.data(), Values.size()));
+}
