+  // Only the selected Apple ARM64 C++ ABI has been qualified here.
+  bool appleArm64Storage() const {
+    const auto &Target = C.getTargetInfo();
+    return C.getLangOpts().CPlusPlus &&
+           C.getCXXABIKind() == TargetCXXABI::AppleARM64 &&
+           Target.getPointerWidth(LangAS::Default) == 64 &&
+           Target.getPointerAlign(LangAS::Default) == 64 &&
+           C.getTypeSize(C.getPointerDiffType()) == 64 &&
+           C.getTypeAlign(C.getPointerDiffType()) == 64;
+  }
+
+  bool referenceField(const FieldDecl *F, uint64_t Offset) {
+    // Reference fields use ConvertTypeForMem's pointer storage, independently
+    // of the language sizeof(referent). Never recurse into the referent.
+    if (!appleArm64Storage() || !isa<CXXRecordDecl>(F->getParent()) ||
+        F->getParent()->isUnion() || semantics(F)) return false;
+    QualType T = F->getType();
+    for (unsigned I = 0; ; ++I) {
+      if (I == 128 || T.getAddressSpace() != LangAS::Default) return false;
+      if (const auto *TT = dyn_cast<TypedefType>(T.getTypePtr()))
+        if (semantics(TT->getDecl())) return false;
+      QualType Next = T.getSingleStepDesugaredType(C);
+      if (Next == T) break;
+      T = Next;
+    }
+    const auto *Ref = T->getAs<ReferenceType>();
+    if (!Ref) return false;
+    QualType Value = Ref->getPointeeType();
+    if (!Value->isObjectType() || Value->isDependentType() ||
+        Value->isVariablyModifiedType() || Value->isSizelessType() ||
+        Value.getAddressSpace() != LangAS::Default ||
+        C.getTypeSize(T) != 64 || C.getTypeAlign(T) != 64) return false;
+    return mark(Offset, 64, 1);
+  }
